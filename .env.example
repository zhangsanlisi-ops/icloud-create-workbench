NODE_ENV=production
TZ=Asia/Shanghai
HOST=0.0.0.0
PORT=4173
APP_ORIGIN=http://服务器IP:4173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/workbench.db
GENERATION_BATCH_LIMIT=5
GENERATION_COOLDOWN_MINUTES=60
GENERATION_TARGET_DEFAULT=750
GENERATION_RETRY_MINUTES=5
INBOX_SYNC_INTERVAL_SECONDS=10
INBOX_SYNC_CONCURRENCY=2
PUBLIC_MAIL_RATE_LIMIT=60
LOG_LEVEL=info
PYTHON_COMMAND=python
PYTHON_BRIDGE=./python/hme_bridge.py

# Optional: let Python/aiohttp iCloud requests use a local HTTP proxy/VPN client.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=127.0.0.1,localhost

